{
    "name": "avisitor/db-transaction-log",
    "description": "DB-backed transaction log for avisitor/dbbase apps: writer with result codes, query store, retention, and a legacy file importer",
    "version": "1.0.0",
    "type": "library",
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "DbTransactionLog\\": "src/"
        }
    },
    "repositories": [
        {
            "type": "vcs",
            "url": "https://github.com/avisitor/dbbase.git"
        }
    ],
    "require": {
        "php": ">=8.1",
        "avisitor/dbbase": "^1.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^10"
    },
    "bin": [
        "bin/import-transaction-log",
        "bin/prune-transactions"
    ],
    "scripts": {
        "test": "phpunit"
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
